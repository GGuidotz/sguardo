{
  "$name": "Sguardo",
  "$description": "Design tokens derived from Glance (github.com/jonnyoo/glance v1.2 and tryglance.app). Single source of truth; Swift and CSS mirror these values.",

  "color": {
    "accent": {
      "$note": "Per-app. Each app overrides `base`; the other steps are derived (see DESIGN.md).",
      "base":   "#3499FF",
      "pale":   "#CFE7FF",
      "bright": "#7FC2FF",
      "deep":   "#1F6BD1",
      "selectedWash": 0.12
    },
    "appAccents": {
      "$note": "Taken from each app's current Style.swift. null = no brand color yet, falls back to accent.base.",
      "typewithme": "#2E7DF5",
      "knock":      "#33C773",
      "tivu":       null,
      "magictouch": null
    },
    "text": {
      "primary":   { "dark": "#EEEEEE",              "light": "rgba(0,0,0,0.85)" },
      "secondary": { "dark": "#BFBFBF",              "light": "rgba(0,0,0,0.50)" },
      "tertiary":  { "dark": "#999999",              "light": "rgba(0,0,0,0.40)" },
      "onAccent":  "#FFFFFF"
    },
    "fill": {
      "row":          { "dark": "rgba(255,255,255,0.08)", "light": "rgba(255,255,255,0.75)" },
      "rowBorder":    { "dark": "rgba(204,204,204,0.12)", "light": "rgba(0,0,0,0.15)" },
      "neutralButton":{ "dark": "rgba(255,255,255,0.14)", "light": "rgba(0,0,0,0.10)" },
      "pickerPill":   { "dark": "rgba(255,255,255,0.05)", "light": "rgba(0,0,0,0.10)" },
      "tile":         { "dark": "rgba(255,255,255,0.05)", "light": "rgba(0,0,0,0.05)" },
      "barTint":      { "dark": "rgba(255,255,255,0.15)", "light": "rgba(255,255,255,0.50)" },
      "barBorder":    { "dark": "rgba(255,255,255,0.16)", "light": "rgba(0,0,0,0.08)" },
      "selectedPill": { "dark": "rgba(255,255,255,0.10)", "light": "rgba(255,255,255,0.70)" },
      "selectedPillBorder": { "dark": "rgba(255,255,255,0.12)", "light": "rgba(0,0,0,0.06)" }
    },
    "island": {
      "$note": "Always-dark transient panels (notch, floating pill, onboarding). Same in both appearances.",
      "panel":        "#000000",
      "surface":      "#1E1E1E",
      "surfaceRaised":"#323232",
      "textPrimary":  "#FFFFFF",
      "textDetail":   "#BDBDBD",
      "textSecondary":"#949494",
      "placeholder":  "#2F2F2F"
    },
    "status": {
      "success":     "#30D158",
      "danger":      "#FF453A",
      "destructive": "#E03B2F",
      "warning":     "#FFBE54",
      "qualityPoor": "#FF5454",
      "qualityFair": "#FFBE54",
      "qualityGood": "#85FF77"
    },
    "web": {
      "background":      "#FBFDFF",
      "foreground":      "#071727",
      "ink":             "#000000",
      "mutedInk":        "rgba(15,23,31,0.42)",
      "mutedCaption":    "rgba(15,23,31,0.23)",
      "panelMuted":      "#EDEFF1",
      "panelDark":       "#0F171F",
      "panelDashed":     "#ACB8C3",
      "videoSurface":    "#D8E3EE",
      "buttonSecondary": "#EEEEEF",
      "buttonSecondaryText": "#313131",
      "navPill":         "rgba(234,234,234,0.75)",
      "navPillBorder":   "rgba(255,252,252,0.25)",
      "navText":         "rgba(49,49,49,0.89)",
      "darkBg":          "#09090A",
      "darkCard":        "#1B1C1D",
      "darkMuted":       "#7E848B",
      "mutedInkInverse": "rgba(255,255,255,0.47)"
    }
  },

  "font": {
    "family": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', Roboto, sans-serif",
    "app": {
      "title":       { "size": 26, "weight": 700 },
      "instruction": { "size": 15, "weight": 500 },
      "body":        { "size": 13, "weight": 400 },
      "bodyEmphasis":{ "size": 13, "weight": 500 },
      "button":      { "size": 13, "weight": 500 },
      "label":       { "size": 12, "weight": 600 },
      "field":       { "size": 12, "weight": 400 },
      "caption":     { "size": 11, "weight": 400 },
      "value":       { "size": 13, "weight": 400, "design": "monospaced" }
    },
    "web": {
      "display": { "size": "clamp(46px, 5.3vw, 80px)",   "weight": 700, "lineHeight": 1.025, "tracking": "-0.02em" },
      "h1":      { "size": "clamp(36px, 4.16vw, 60px)",  "weight": 700, "lineHeight": 1.025, "tracking": "-0.02em" },
      "h2":      { "size": "clamp(24px, 3.33vw, 40px)",  "weight": 700, "lineHeight": 1.025, "tracking": "-0.02em" },
      "h3":      { "size": "clamp(18px, 2.16vw, 26px)",  "weight": 600, "lineHeight": 1.1,   "tracking": "-0.02em" },
      "lead":    { "size": "clamp(15px, 1.66vw, 20px)",  "weight": 500, "lineHeight": 1.3,   "tracking": "-0.01em" },
      "body":    { "size": "16px", "weight": 400, "lineHeight": 1.35 },
      "small":   { "size": "14px", "weight": 500, "lineHeight": 1.25 },
      "micro":   { "size": "12px", "weight": 500, "lineHeight": 1.25 }
    }
  },

  "space": { "1": 4, "2": 6, "3": 8, "4": 10, "5": 12, "6": 14, "7": 16, "8": 24, "9": 28, "10": 32, "11": 40, "12": 60 },

  "size": {
    "rowHeight": 44,
    "buttonLarge": 38,
    "buttonHeader": 30,
    "buttonSmall": 26,
    "field": 40,
    "tabBar": 54,
    "tabItem": 42,
    "statusDot": 16,
    "glyph": 15,
    "settingsWindow": [500, 620],
    "panelWidth": 380,
    "subtitleMaxWidth": 260
  },

  "radius": {
    "$note": "All rounded rects use the continuous (squircle) style. Interactive controls are capsules.",
    "control": "capsule",
    "tile": 13,
    "row": 16,
    "islandSmall": 22,
    "island": 48,
    "islandLarge": 60,
    "web": { "button": "999px", "chip": "12px", "card": "clamp(28px, 4.33vw, 52px)", "cardSmall": "clamp(20px, 2.9vw, 44px)" }
  },

  "border": { "hairline": 1, "selectionRing": 3.5, "selectionOutset": 2.5, "webFocusRing": "inset 0 0 0 1.5px var(--accent)" },

  "shadow": {
    "tile":   "0 0 4px rgba(0,0,0,0.15)",
    "web":    "0 10px 28px rgba(7,23,39,0.10)",
    "webNav": "0 -12px 40px rgba(7,23,39,0.16)"
  },

  "motion": {
    "spring": {
      "snappy":   { "response": 0.35, "damping": 0.82, "use": "selection, tab change, toggles" },
      "standard": { "response": 0.42, "damping": 0.80, "use": "step change, panel resize" },
      "expand":   { "response": 0.45, "damping": 0.70, "use": "island/panel opening (small overshoot)" },
      "collapse": { "response": 0.45, "damping": 1.00, "use": "island/panel closing (no overshoot)" }
    },
    "duration": { "hover": 0.18, "fast": 0.2, "state": 0.28, "fade": 0.35, "reveal": 0.45 },
    "web": {
      "ease": "cubic-bezier(.16, 1, .3, 1)",
      "easeSoft": "cubic-bezier(.22, 1, .36, 1)",
      "revealDuration": "0.9s",
      "stagger": "50ms"
    },
    "labelReveal": { "offset": 10, "blur": 4 },
    "disabledOpacity": 0.4,
    "holdToConfirm": 3.0
  },

  "layout": {
    "contentPadding": 16,
    "rowInset": 14,
    "rowSpacing": 12,
    "sectionTitleInset": 10,
    "web": { "gutter": "clamp(16px, 4.2vw, 60px)", "siteMax": "1160px", "sectionGap": "clamp(96px, 12vw, 180px)" }
  }
}
